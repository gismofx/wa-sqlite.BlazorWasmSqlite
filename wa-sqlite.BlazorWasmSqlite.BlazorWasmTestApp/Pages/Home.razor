@page "/"

@using wa_sqlite.BlazorWasmSqlite.Attributes
@using wa_sqlite.BlazorWasmSqlite.Extensions
@using System.Runtime.InteropServices.JavaScript
@using wa_sqlite.BlazorWasmSqlite.DBConnection
@using Dapper

<PageTitle>Home</PageTitle>
<MudContainer Gutters=true>
<MudGrid>
    <MudItem xs="12" Class="mt-2">
        <MudPaper Class="pa-2">
            <MudStack Row="true">
                <MudText Typo="Typo.h6">Status: @Status</MudText>
                <MudButton Variant="Variant.Filled" OnClick="@(async ()=> await OpenClick())">Open</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="@(async ()=> await InsertTableAndData())">Add Sample Data</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="@(async ()=> await UpsertClick())">Upsert Test</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(async ()=> await JsImportTestClick())">JSImport Test</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(async ()=> await DapperTestClick())">Dapper Test</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/dbreader-tests">DbReader Tests</MudButton>
            </MudStack>
            </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper >
            <MudList ReadOnly="false" T="SqliteTableInfo">
                <MudListItem Text="Refresh Tables" Icon="@Icons.Material.Filled.Refresh" OnClick="@(async ()=>await RefreshTablesClick())"/>
                <MudDivider />
                @foreach (var table in Tables)
                {
                    <MudListItem Value="@table" Text="@table.Name" Icon="@Icons.Material.Filled.TableRows" ExpandedChanged="@(async (b) => await LoadColumns(table.Name!))">
                     <NestedList>
                         @foreach (var col in table.Columns)
                            {
                                <MudListItem Text="@($"{col.Name}({col.Type})")" Icon="@Icons.Material.Filled.DataArray" />
                            }
                    </NestedList>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="8">
        <MudPaper>
            <MudStack>
                <MudTextField Lines="10" Variant="Variant.Outlined" Label="Query" @bind-Value="@Query"></MudTextField>
                <MudButton Variant="Variant.Filled"  OnClick="@(async () => await ExecuteQueryClick())">Execute</MudButton>
                <MudButton Variant="Variant.Filled" OnClick="@(async () => await ExecuteQueryParam())">Execute Param</MudButton>
                <MudTextField Lines="10" Variant="Variant.Filled" Label="Result" @bind-Value="@QueryResult"></MudTextField>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>
</MudContainer>



@code{
    private SqliteWasmConnection? _conn;
    private string Status = "Closed";
    private string Query = string.Empty;
    private string QueryResult = string.Empty;
    private IEnumerable<SqliteTableInfo> Tables = Enumerable.Empty<SqliteTableInfo>();

    private async Task<SqliteWasmConnection> EnsureConnectionAsync()
    {
        if (_conn == null || _conn.State != System.Data.ConnectionState.Open)
        {
            _conn = new SqliteWasmConnection("MyApp", "MyFile");
            await _conn.OpenAsync();
            Status = "Open";
        }
        return _conn;
    }

    private async Task OpenClick()
    {
        var conn = await EnsureConnectionAsync();
        Status = conn.State == System.Data.ConnectionState.Open ? "Open" : "Closed";
    }

    private async Task RefreshTablesClick()
    {
        var conn = await EnsureConnectionAsync();
        Tables = await conn.QueryAllTablesAsync();
    }

    private async Task LoadColumns(string tableName)
    {
        var conn = await EnsureConnectionAsync();
        var columns = await conn.QueryTableSchemaAsync(tableName);
        Tables.Where(x => x.Name == tableName).First().Columns = columns;
    }

    private async ValueTask ExecuteQueryClick()
    {
        if (string.IsNullOrWhiteSpace(Query)) return;
        var conn = await EnsureConnectionAsync();
        var results = await conn.QueryAsync<dynamic>(Query);
        QueryResult = ToJsonString(results);
    }

    private async ValueTask ExecuteQueryParam()
    {
        var conn = await EnsureConnectionAsync();
        var results = await conn.QueryAsync<dynamic>(
            "SELECT * FROM contacts WHERE id = @id", new { id = 1 });
        QueryResult = ToJsonString(results);
    }

    private string ToJsonString(IEnumerable<dynamic> results)
    {
        var list = results.ToList();
        if (list.Count == 0) return "The query returned no results.";
        var opts = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
        return System.Text.Json.JsonSerializer.Serialize(
            list.Select(r => (IDictionary<string, object>)r), opts);
    }

    private async Task InsertTableAndData()
    {
        var conn = await EnsureConnectionAsync();
        await conn.ExecuteAsync(@"CREATE TABLE IF NOT EXISTS contacts (
            id INTEGER PRIMARY KEY,
            FirstName TEXT NOT NULL,
            LastName TEXT NOT NULL,
            Email TEXT UNIQUE,
            epochTimeSeconds NUMERIC)");

        var rows = await conn.ExecuteAsync(@"INSERT OR REPLACE INTO contacts
            (id, FirstName, LastName, Email, EpochTimeSeconds) VALUES
            (1,'Bob','Dob','bob@email.com',1),
            (2,'Tina','Tuna','tina@email.com',2),
            (3,'Rob','Lob','rob@email.com',3),
            (4,'John','Shmon','john@email.com',4),
            (5,'Sam','Ham','sam@email.com',5),
            (6,'Rachel','Achel','rachel@email.com',6)");
        QueryResult = $"Inserted {rows} row(s).";
    }

    private async Task UpsertClick()
    {
        var conn = await EnsureConnectionAsync();
        var models = new List<ContactModel>
        {
            new ContactModel { Id = 10, Email = "grog@bemail.com",  FirstName = "Grog",  LastName = "Dog",  EpochTimeSeconds = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() },
            new ContactModel { Id = 11, Email = "grog2@bemail2.com", FirstName = "Grog2", LastName = "Dog2", EpochTimeSeconds = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }
        };
        var changes = await conn.UpsertAsync<ContactModel>("Contacts", models);
        QueryResult = $"Upserted {changes} row(s).";
    }

    private async Task JsImportTestClick()
    {
        try
        {
            // 1. Open via JSImport
            var dbConn = await SqliteJsInterop.OpenAsync("MyApp", "MyFile");
            QueryResult = $"[JSImport] Opened: conn={dbConn}\n";

            // 2. Create table
            var execResult = await SqliteJsInterop.ExecuteAsync(dbConn,
                "CREATE TABLE IF NOT EXISTS jsimport_test (id INTEGER PRIMARY KEY, name TEXT, value REAL)", null);
            var changes = execResult.GetPropertyAsInt32("changes");
            var error = execResult.GetPropertyAsString("error");
            QueryResult += $"[JSImport] Create table: changes={changes}, error='{error}'\n";

            // 3. Insert rows
            var paramJson = System.Text.Json.JsonSerializer.Serialize(
                new Dictionary<string, object> { ["@name"] = "test1", ["@val"] = 42.5 });
            execResult = await SqliteJsInterop.ExecuteAsync(dbConn,
                "INSERT OR REPLACE INTO jsimport_test (id, name, value) VALUES (1, @name, @val)", paramJson);
            changes = execResult.GetPropertyAsInt32("changes");
            QueryResult += $"[JSImport] Insert: changes={changes}\n";

            // 4. Query via queryJson (string return — fast path)
            var json = await SqliteJsInterop.QueryJsonAsync(dbConn,
                "SELECT * FROM jsimport_test", null);
            QueryResult += $"[JSImport] QueryJson: {json}\n";

            QueryResult += "[JSImport] All tests passed!";
        }
        catch (Exception ex)
        {
            QueryResult = $"[JSImport] ERROR: {ex.Message}\n{ex.StackTrace}";
        }
    }

    private async Task DapperTestClick()
    {
        try
        {
            var conn = await EnsureConnectionAsync();
            QueryResult = "[Dapper] Connected\n";

            await conn.ExecuteAsync("CREATE TABLE IF NOT EXISTS dapper_test (Id INTEGER PRIMARY KEY, Name TEXT, Score REAL)");
            QueryResult += "[Dapper] Table created\n";

            var cmd = conn.CreateCommand();
            cmd.CommandText = "INSERT OR REPLACE INTO dapper_test (Id, Name, Score) VALUES (@Id, @Name, @Score)";
            cmd.Parameters.Add("@Id", 1);
            cmd.Parameters.Add("@Name", "Alice");
            cmd.Parameters.Add("@Score", 95.5);
            var rows = await cmd.ExecuteNonQueryAsync();
            QueryResult += $"[Dapper] Insert: {rows} row(s)\n";

            var results = await conn.QueryAsync<dynamic>("SELECT * FROM dapper_test");
            foreach (var r in results)
                QueryResult += $"[Dapper] Row: Id={r.Id}, Name={r.Name}, Score={r.Score}\n";

            var count = await conn.ExecuteScalarAsync<int>("SELECT COUNT(*) FROM dapper_test");
            QueryResult += $"[Dapper] Count: {count}\n";

            var txn = await conn.BeginTransactionAsync();
            await conn.ExecuteAsync("INSERT OR REPLACE INTO dapper_test (Id, Name, Score) VALUES (2, 'Bob', 88.0)");
            await txn.CommitAsync();
            QueryResult += "[Dapper] Transaction committed\n";

            var allRows = await conn.QueryAsync<dynamic>("SELECT * FROM dapper_test ORDER BY Id");
            foreach (var r in allRows)
                QueryResult += $"[Dapper] Row: Id={r.Id}, Name={r.Name}, Score={r.Score}\n";

            QueryResult += "[Dapper] All tests passed!";
        }
        catch (Exception ex)
        {
            QueryResult = $"[Dapper] ERROR: {ex.Message}\n{ex.StackTrace}";
        }
    }
}