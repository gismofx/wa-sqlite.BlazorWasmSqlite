@inherits LayoutComponentBase
<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h5" Class="ml-3">SQLite WASM Test App</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/"               Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/dbreader-tests"  Icon="@Icons.Material.Filled.BugReport">DbReader Tests</MudNavLink>
            <MudNavLink Href="/pagination-benchmark" Icon="@Icons.Material.Filled.Speed">Pagination Benchmark</MudNavLink>
            <MudNavLink Href="/type-coverage"        Icon="@Icons.Material.Filled.CheckCircle">Type Coverage</MudNavLink>
            <MudNavLink Href="/null-binding"         Icon="@Icons.Material.Filled.Warning">Null Binding</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
}



