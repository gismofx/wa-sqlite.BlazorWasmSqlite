<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Multi-target rather than move. Consumers still on net8.0 - DVM.Core is one - resolve the
         net8.0 asset unchanged, while a net10.0 consumer gets a framework-native one. Dropping
         net8.0 would break them the moment this ships. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>wa_sqlite.BlazorWasmSqlite</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>wa-sqlite.BlazorWasmSqlite</PackageId>
    <Version>1.1.2</Version>
    <Authors>gismofx</Authors>
    <Copyright>Copyright © 2026 gismofx</Copyright>
    <Description>Blazor WebAssembly SQLite library backed by IndexedDB, running off the main thread in a Web Worker. Built on @journeyapps/wa-sqlite with Dapper support. Includes automatic JSPI/Asyncify detection for optimal browser compatibility.</Description>
    <PackageTags>blazor;wasm;sqlite;indexeddb;wa-sqlite;dapper;offline;webassembly;browser</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>wa-sqlite.BlazorWasmSqliteIcon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/gismofx/wa-sqlite.BlazorWasmSqlite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gismofx/wa-sqlite.BlazorWasmSqlite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\wa-sqlite.BlazorWasmSqliteIcon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapper 2.0.4 targets netstandard2.0, so it resolves and runs on net10 unchanged. It is
         from 2020 and this library's whole design leans on Dapper's open-if-closed/close-after
         contract, which is an argument for bumping it - but on its own, with the suite as the
         gate, not bundled with a target-framework change. The tests already run 2.1.72 against
         it, which is its own smell and the place to start. -->
    <PackageReference Include="Dapper" Version="2.0.4" />
  </ItemGroup>

  <!-- Framework-matched, so each target gets the Blazor components built for it rather than
       resolving an older asset by compatibility. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal members (Coerce, etc.) for direct unit testing -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>wa-sqlite.BlazorWasmSqlite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
	
	<PropertyGroup>
		<!-- Always production, even in Debug. The committed wwwroot bundles ARE the shipped
		     artifact, so a Debug build emitting development bundles silently replaces them with
		     something that must never be packed - which is how an unminified worker ended up in
		     the published 1.0.1. Debugging the worker source is still possible: run
		     `npm run-script dev` by hand, then restore wwwroot from git to put it back. -->
		<NpmScript>prod</NpmScript>
	</PropertyGroup>

	<!-- Runs once per build/pack. An Inputs/Outputs pair was tried here to make it incremental
	     and did NOT skip, so the attributes are gone rather than left in place describing
	     behaviour that was not happening. It costs about two seconds, and because the script is
	     pinned to production the regenerated bundles are byte-identical to the committed ones -
	     verified with `git diff`, which reports no change after a rebuild.

	     Hooked to DispatchToInnerBuilds, not PreBuildEvent: this project multi-targets
	     net8.0;net10.0, and DispatchToInnerBuilds is the one target that runs exactly once, in
	     the OUTER cross-targeting pass, before MSBuild fans out to the per-TargetFramework inner
	     builds - neither inner build's target graph includes it at all. PreBuildEvent, by
	     contrast, fires once PER inner build, so this ran npm run-script twice on every single
	     build and pack (confirmed: `dotnet pack` logged two separate "worker ... compiled"
	     lines), both writing the same wwwroot. Harmless while webpack's output stays
	     content-hash-deterministic against unchanged source - which is exactly the assumption
	     that stopped holding for the 1.1.0 publish, where sqlite-worker.js's embedded chunk-hash
	     map ended up referencing async-chunk filenames that don't exist in the same package.
	     Two uncoordinated writers to one output directory, even sequential ones, is not an
	     invariant worth relying on for what gets published - run it once. -->
	<Target Name="InstallAndRunNpm" BeforeTargets="DispatchToInnerBuilds" Condition="'$(SkipNpmBuild)' != 'true'">
		<!-- The include=dev flag below is load-bearing: webpack, webpack-cli and terser are all
		     devDependencies, and a machine with NODE_ENV=production (or npm config omit=dev)
		     silently skips them. npm then reports "up to date" against a tree with no
		     node_modules/.bin, and the next line fails with "'webpack' is not recognized" —
		     which reads as a broken repo and invites SkipNpmBuild=true, which packs whatever
		     stale bundles happen to be committed. -->
		<Exec Command="npm install --include=dev" WorkingDirectory="NpmJS" />
		<Exec Command="npm run-script $(NpmScript)" WorkingDirectory="NpmJS" />
	</Target>
	

</Project>
